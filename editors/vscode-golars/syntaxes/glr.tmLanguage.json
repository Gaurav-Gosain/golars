{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "golars",
  "scopeName": "source.glr",
  "patterns": [
    { "include": "#comments" },
    { "include": "#commands" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" }
  ],
  "repository": {
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.glr"
    },
    "commands": {
      "match": "^\\.?\\b(load|use|stash|frames|drop_frame|save|write|show|ishow|browse|schema|describe|head|tail|select|drop|filter|sort|limit|groupby|join|explain|explain_tree|tree|graph|show_graph|mermaid|collect|reset|source|timing|info|clear|help|h|exit|quit|q|reverse|sample|shuffle|unique|null_count|glimpse|size|cast|fill_null|fillnull|drop_null|dropnull|rename|sum|mean|avg|min|max|median|std|with_row_index|pwd|ls|cd|sum_horizontal|mean_horizontal|min_horizontal|max_horizontal|all_horizontal|any_horizontal|sum_all|mean_all|min_all|max_all|std_all|var_all|median_all|count_all|null_count_all|with|unnest|explode|upsample|to_dummies|join_asof|group_by_dynamic|groupby_dynamic|scan_csv|scan_parquet|scan_ipc|scan_arrow|scan_ndjson|scan_jsonl|scan_json|scan_auto|fill_nan|forward_fill|ff|backward_fill|bf|top_k|bottom_k|transpose|unpivot|melt|partition_by|skew|kurtosis|approx_n_unique|approx_nunique|corr|cov|pivot)\\b",
      "name": "keyword.control.glr"
    },
    "keywords": {
      "match": "\\b(as|on|asc|desc|and|or|not|in|is_null|is_not_null|contains|starts_with|ends_with|like|not_like|when|then|otherwise|true|false|null|inner|left|cross|every|period|offset|by|backward|forward|nearest|tolerance)\\b",
      "name": "keyword.other.glr"
    },
    "strings": {
      "name": "string.quoted.double.glr",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {"match": "\\\\.", "name": "constant.character.escape.glr"}
      ]
    },
    "numbers": {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.glr"
    }
  }
}
