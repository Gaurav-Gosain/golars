{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "golars",
  "scopeName": "source.glr",
  "patterns": [
    {
      "include": "#commands"
    },
    {
      "include": "#symbol-commands"
    },
    {
      "include": "#statement-keywords"
    },
    {
      "include": "#assignment"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "commands": {
      "match": "^\\s*(\\.)?\\b(load|use|stash|frames|drop_frame|save|write|show|ishow|browse|schema|describe|head|tail|select|drop|filter|sort|limit|groupby|join|explain|explain_tree|tree|graph|show_graph|mermaid|collect|reset|source|timing|info|clear|help|h|exit|quit|q|reverse|sample|shuffle|unique|null_count|glimpse|size|cast|fill_null|fillnull|drop_null|dropnull|rename|sum|mean|avg|min|max|median|std|with_row_index|pwd|ls|cd|sum_horizontal|mean_horizontal|min_horizontal|max_horizontal|all_horizontal|any_horizontal|sum_all|mean_all|min_all|max_all|std_all|var_all|median_all|count_all|null_count_all|with|unnest|explode|upsample|to_dummies|join_asof|group_by_dynamic|groupby_dynamic|scan_csv|scan_parquet|scan_ipc|scan_arrow|scan_ndjson|scan_jsonl|scan_json|scan_auto|fill_nan|forward_fill|ff|backward_fill|bf|top_k|bottom_k|transpose|unpivot|melt|partition_by|skew|kurtosis|approx_n_unique|approx_nunique|corr|cov|pivot)\\b",
      "captures": {
        "1": {
          "name": "punctuation.definition.command.glr"
        },
        "2": {
          "name": "keyword.control.glr"
        }
      }
    },
    "symbol-commands": {
      "comment": "Commands a word boundary cannot delimit.",
      "match": "^\\s*(\\.)?(null-count|\\?)(?=\\s|$)",
      "captures": {
        "1": {
          "name": "punctuation.definition.command.glr"
        },
        "2": {
          "name": "keyword.control.glr"
        }
      }
    },
    "paths": {
      "comment": "Paths: a slash, `~`, `..`, or a data or script file name.",
      "match": "(?<=\\s)(?:[\\w.~-]+/[\\w./~-]*|/[A-Za-z_.~][\\w./~-]*|~|\\.\\.|[\\w-]+(?:\\.[\\w-]+)*\\.(?:csv|tsv|parquet|pq|arrow|ipc|json|ndjson|jsonl|glr))(?=\\s|$)",
      "name": "string.unquoted.path.glr"
    },
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.glr"
    },
    "statement-keywords": {
      "match": "(?<![.\\w])\\b(as|on|asc|desc|inner|left|cross|by|every|period|offset|closed|label|start_by|backward|forward|nearest|tolerance|drop_first)\\b(?!\\s*[=(.])",
      "name": "keyword.other.glr"
    },
    "assignment": {
      "comment": "`name = expr` in with, select and groupby.",
      "match": "\\b([A-Za-z_]\\w*)\\s*(=)(?!=)",
      "captures": {
        "1": {
          "name": "variable.other.definition.glr"
        },
        "2": {
          "name": "keyword.operator.assignment.glr"
        }
      }
    },
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#paths"
        },
        {
          "include": "#agg-spec"
        },
        {
          "include": "#durations"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#word-operators"
        },
        {
          "include": "#conditional"
        },
        {
          "include": "#namespace-call"
        },
        {
          "include": "#member"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#arguments"
        },
        {
          "include": "#lists"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#line-continuation"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.glr",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.glr"
            }
          ]
        },
        {
          "name": "string.quoted.single.glr",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.glr"
            }
          ]
        }
      ]
    },
    "agg-spec": {
      "comment": "`col:op[:alias]` aggregation spec.",
      "match": "\\b([A-Za-z_]\\w*)(:)([A-Za-z_]\\w*)(?:(:)([A-Za-z_]\\w*))?\\b",
      "captures": {
        "1": {
          "name": "variable.other.glr"
        },
        "2": {
          "name": "punctuation.separator.glr"
        },
        "3": {
          "name": "support.function.aggregate.glr"
        },
        "4": {
          "name": "punctuation.separator.glr"
        },
        "5": {
          "name": "variable.other.definition.glr"
        }
      }
    },
    "durations": {
      "match": "\\b\\d+(?:ns|us|ms|mo|s|m|h|d|w|y|q|i)(?:\\d+(?:ns|us|ms|mo|s|m|h|d|w|y|q|i))*\\b",
      "name": "constant.other.duration.glr"
    },
    "numbers": {
      "match": "(?<![\\w.])(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?\\b",
      "name": "constant.numeric.glr"
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.glr"
        },
        {
          "match": "\\bnull\\b",
          "name": "constant.language.null.glr"
        }
      ]
    },
    "word-operators": {
      "match": "\\b(and|or|not|in|is_null|is_not_null|contains|starts_with|ends_with|like|not_like)\\b(?!\\s*\\()",
      "name": "keyword.operator.word.glr"
    },
    "conditional": {
      "match": "\\b(when|then|otherwise)\\b",
      "name": "keyword.control.conditional.glr"
    },
    "namespace-call": {
      "comment": "`dt.year(ts)` and the `.dt.` step of `ts.dt.year()`.",
      "match": "(?:(\\.)|(?<![\\w.]))\\b(str|dt|list|arr|struct|name|bin|cat)(\\.)(?=[A-Za-z_])",
      "captures": {
        "1": {
          "name": "punctuation.accessor.glr"
        },
        "2": {
          "name": "entity.name.namespace.glr"
        },
        "3": {
          "name": "punctuation.accessor.glr"
        }
      }
    },
    "member": {
      "comment": "A method: `x.round(2)`, `price.sum`.",
      "match": "(\\.)([A-Za-z_]\\w*)\\b",
      "captures": {
        "1": {
          "name": "punctuation.accessor.glr"
        },
        "2": {
          "name": "entity.name.function.member.glr"
        }
      }
    },
    "function-call": {
      "match": "\\b([A-Za-z_]\\w*)(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.glr"
        }
      }
    },
    "arguments": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.arguments.begin.glr"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.arguments.end.glr"
        }
      },
      "patterns": [
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(=)(?!=)",
          "captures": {
            "1": {
              "name": "variable.parameter.glr"
            },
            "2": {
              "name": "keyword.operator.assignment.glr"
            }
          }
        },
        {
          "include": "#expression"
        },
        {
          "match": ",",
          "name": "punctuation.separator.arguments.glr"
        }
      ]
    },
    "lists": {
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.list.begin.glr"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.list.end.glr"
        }
      },
      "patterns": [
        {
          "include": "#expression"
        },
        {
          "match": ",",
          "name": "punctuation.separator.list.glr"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "==|!=|<=|>=|<|>",
          "name": "keyword.operator.comparison.glr"
        },
        {
          "match": "\\*\\*|//|[-+*/%]",
          "name": "keyword.operator.arithmetic.glr"
        }
      ]
    },
    "line-continuation": {
      "match": "\\\\$",
      "name": "constant.character.escape.line-continuation.glr"
    }
  }
}
